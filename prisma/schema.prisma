generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("viewer") // "admin" | "editor" | "viewer"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  EntryComment[]
}

model Award {
  id              Int       @id @default(autoincrement())
  year            Int       @unique
  name            String
  isActive        Boolean   @default(false)
  entryStartDate  DateTime?
  entryEndDate    DateTime?
  notifyEmails    String    @default("") // comma-separated email addresses for admin notifications
  createdAt       DateTime  @default(now())
  entries         Entry[]
  prospects       Prospect[]
}

model Entry {
  id                   Int          @id @default(autoincrement())
  awardId              Int
  answerNo             String       @unique
  answeredAt           String
  ipAddress            String       @default("")
  companyName          String
  department           String       @default("")
  contactLastName      String
  contactFirstName     String
  email                String
  phone                String       @default("")
  tradeShowExhibition  String       @default("")
  prefecture           String       @default("")
  productName          String
  productCategory      String       @default("")
  price                String       @default("")
  purchaseLocation     String       @default("")
  referenceUrl         String       @default("")
  productPhotosRaw     String       @default("")
  localAppeal          String       @default("")
  tasteAppeal          String       @default("")
  packageAppeal        String       @default("")
  cookingMethod        String       @default("")
  otherAppeal          String       @default("")
  retailPartnership    String       @default("")
  bacteriaInspection   String       @default("")
  expirationInspection String       @default("")
  manufacturingLicense String       @default("")
  entryProductLicense  String       @default("")
  hygieneManager       String       @default("")
  // 「大賞をどこで知ったか」。選択肢は src/components/entry-form.tsx の
  // REFERRAL_SOURCE_OPTIONS。他の選択式項目（bacteriaInspection 等）と同じく
  // 「その他」を選ぶと "その他: 自由入力" の形で 1 カラムに畳んで保存する。
  // 2026年8月に追加した設問なので、それ以前のエントリーは空文字になる。
  referralSource       String       @default("")
  remarks              String       @default("")
  prizeLevel           String       @default("")
  reviewStatus         String       @default("")
  // 商品到着ラベル（"second_arrived" / "final_arrived" のカンマ区切り、複数可）。
  // reviewStatus と同じ「カンマ区切り複数タグ」の形で持つが、審査結果とは無関係の
  // 別軸の記録なので意図的に別カラムにしている。editor も付け外しできる
  // canSetItemArrival で保護されており、reviewStatus を守る canSetPrize とは
  // 混ぜない（src/lib/role-shared.ts 参照）。
  //
  // No @@index: /reviews が `contains` で絞り込むのは reviewStatus と同じ使い方だが、
  // reviewStatus 自体も索引されておらず（現状 Entry は125件程度で年度ごとにしか
  // 増えない）、この規模でフルスキャンのコストは無視できる。reviewStatus と対称に
  // しておき、将来 reviewStatus に索引を張るならこちらも同時に検討する。
  itemArrivalStatus    String       @default("")
  createdAt            DateTime     @default(now())
  award                Award        @relation(fields: [awardId], references: [id])
  images               EntryImage[]
  comments             EntryComment[]
  invoices             Invoice[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userEmail String   @default("")
  action    String   // "create" | "update" | "delete" | "prize" | "upload" | "login" | "bulk_prize" | "item_arrival" | "bulk_item_arrival"
  target    String   // "entry" | "user" | "session"
  targetId  String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model EntryComment {
  id         Int      @id @default(autoincrement())
  entryId    Int
  userId     Int?     // 投稿者。ユーザー削除時も履歴を残すため null 許容
  authorName String   @default("")  // 投稿者名のスナップショット（ユーザー削除後も表示できるように）
  body       String
  createdAt  DateTime @default(now())
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EntryImage {
  id        Int    @id @default(autoincrement())
  entryId   Int
  imageUrl  String
  imageType String // "main" or "sub"
  sortOrder Int    @default(0)
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Contact {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String   @default("")
  companyName String   @default("")
  phone       String   @default("")
  source      String   @default("") // "entry" | "csv" | "manual" | "form"
  subscribed  Boolean  @default(true)
  optInAt     DateTime?
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships ContactListMembership[]
}

model ContactList {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  memberships ContactListMembership[]
}

model ContactListMembership {
  id        Int         @id @default(autoincrement())
  contactId Int
  listId    Int
  addedAt   DateTime    @default(now())
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
}

model Suppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  reason    String   // "unsubscribe" | "bounce" | "manual"
  createdAt DateTime @default(now())
}

model EmailLog {
  id           Int       @id @default(autoincrement())
  toEmail      String
  subject      String
  status       String    // "sent" | "failed" | "skipped" | "test"
  sentBy       String    @default("")
  createdAt    DateTime  @default(now())
  // Resend's message id for this send. Used to match incoming
  // /api/webhooks/resend delivery events back to the row that created them
  // (see src/app/api/webhooks/resend/route.ts). Empty for rows created
  // before this column existed, and for rows where the send never reached
  // Resend (e.g. missing RESEND_API_KEY, or skipped due to suppression).
  messageId    String    @default("")
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  // Bounce detail from Resend's payload (bounce.type / bounce.subType /
  // bounce.message), e.g. "Permanent / Suppressed: The recipient's email
  // address is on the suppression list...". Empty unless bouncedAt is set.
  bounceReason String    @default("")

  // Webhook lookups are always `WHERE messageId = ?`, so this index is
  // required for that query to be a lookup rather than a full table scan.
  @@index([messageId])
  // The delivery-history admin screen (src/app/email-logs/page.tsx) always
  // orders by createdAt desc with skip/take pagination; without this index
  // that query degrades to a full-table sort as EmailLog grows past the
  // current ~300 rows.
  @@index([createdAt])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Form {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  description     String   @default("")
  status          String   @default("draft") // "draft" | "published" | "closed"
  fields          Json     // フィールド定義の配列 (see src/lib/form.ts for shape)
  targetListId    Int?     // 回答者を登録する見込みリスト（任意）
  requireOptIn    Boolean  @default(false)
  thankYouMessage String   @default("")
  autoReplyEnabled Boolean @default(false)
  autoReplySubject String  @default("")
  autoReplyBody    String  @default("")
  notifyEmails    String   @default("") // comma-separated email addresses for admin notifications
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  submissions     FormSubmission[]
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    Int
  answers   Json     // { fieldId: value } 。ファイルはBlobのURL文字列（複数可なら配列）
  contactId Int?
  ipAddress String   @default("")
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
}

// Standalone "追客リスト" (prospecting list) of candidate manufacturers to
// reach out to for future award entries. Deliberately has NO relation to
// Contact/ContactList/Entry — it's a separate sales-outreach concern, gated
// by its own canManageProspects flag (see src/lib/role-shared.ts). The ONLY
// relation is Award, and only for year-scoping (see awardId below) — it
// still has nothing to do with Entry/Contact.
//
// makerName/prefecture/productName/tempZone/supplement/url come
// from a one-time-per-year (and repeatable) Excel import — see
// importProspectsFromExcel in src/lib/prospect.ts. A re-import skips any row
// whose makerName+productName pair already exists WITHIN THE SAME awardId,
// so the four operational columns below (hand-maintained through the app,
// not the spreadsheet) are never clobbered by a re-upload of the source
// list, while the same maker can still be re-added the following year.
//
// @@index([awardId]): unlike Entry/Contact this table is NOT capped at one
// award's worth of rows — every yearly re-import adds another ~277 rows on
// top of prior years, and awardId is the one filter that's on every single
// query (list, filter-option aggregation, import dedupe), so it's worth
// indexing now rather than waiting for it to become a scan of an
// ever-growing multi-year table. contactStatus/prefecture/
// assignee/keyword search stay unindexed, same reasoning as before: each
// year's slice is still only ~hundreds of rows.
model Prospect {
  id            Int      @id @default(autoincrement())
  // Year-scoped through Award rather than a raw `year Int`: award years get
  // renumbered (2025→2026, 2026→2027 in Aug 2026), and a stored number would
  // have been left behind. Deliberately the only relation on this model —
  // whether a maker entered is answered on the entries screen, so there is
  // nothing to join to Contact or Entry here.
  //
  // No default: every create path (POST /api/prospects, the Excel import)
  // passes awardId explicitly, and a default would quietly file anything
  // that forgot to under whichever award it named. The column was introduced
  // with a temporary @default so Postgres could backfill the 277 rows that
  // predated it; that default has since been dropped.
  awardId       Int
  makerName     String                        // メーカー名
  prefecture    String   @default("")         // 県名
  productName   String   @default("")         // 商品名
  tempZone      String   @default("")         // サイトで確認できる温度帯
  supplement    String   @default("")         // 補足
  url           String   @default("")         // URL
  // 運用項目（アプリ上で手入力・編集する）。Excelインポートでは触らない。
  contactStatus String   @default("未着手")   // コンタクト状況: 未着手/連絡済/資料送付済/エントリー意向
  assignee      String   @default("")         // 担当者
  email         String   @default("")         // 連絡先（メールアドレス）
  phone         String   @default("")         // 連絡先（電話番号）
  memo          String   @default("")         // 備考・メモ欄
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // No onDelete override — same default (Restrict) as Entry.award below, so
  // an award can't be deleted out from under prospects that still belong to
  // it.
  award         Award    @relation(fields: [awardId], references: [id])

  @@index([awardId])
}

// 請求項目マスタ（"エントリー費用" "早期割引" 等）。請求書作成時にここから選んで
// InvoiceLine に金額をコピーする（下記 InvoiceLine 参照）。unitPrice はマイナス
// 可 — 早期割引のような値引き行もこのマスタの1レコードとして表現するため
// （割引専用のフラグやテーブルを別に持たない）。年度に紐付かない横断のマスタ:
// 項目自体（エントリー費用・早割など）は年度をまたいで使い回すため、Prospect/
// Entry と違って awardId を持たない。
model InvoiceItem {
  id        Int      @id @default(autoincrement())
  name      String                // 品名（例:「エントリー費用」）
  unitPrice Int                   // 単価・税別（円）。マイナス可（早期割引など）
  sortOrder Int      @default(0)  // マスタ管理画面での表示順（手動並び替え）
  // 「請求書に項目を追加」ピッカーに出すかどうかのフラグ（例: 早割の受付期間が
  // 終わったので一時的に選べなくしたいが、まだ削除はしたくない、というケース向け）。
  // 物理削除（管理画面からの「削除」操作、src/app/api/invoice-items/[id]/route.ts
  // DELETE）とは別の概念 — InvoiceLine は InvoiceItem への外部キーを持たず金額等の
  // 値をコピーして保持する（下記 InvoiceLine 参照）ため、マスタの行を物理削除しても
  // 既存の請求書内容には一切影響しない。isActive はあくまで「今後の請求書作成時に
  // ピッカーへ出すか」だけを制御する表示上のフラグ。
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// エントリー企業向けの請求書。1件の Entry に対して複数の Invoice を作れる
// （再発行・別件の請求など）ため Entry 側は 1:多。Entry を削除しようとしても
// 発行済みの請求書がある限り消せないよう、他の年度スコープ系リレーション
// （Entry.award など）と同じくデフォルト（Restrict）のまま onDelete を
// 上書きしていない — 実在する金銭書類の参照整合性を、値引きの都合等で
// 安易に失わせないため。
model Invoice {
  id            Int      @id @default(autoincrement())
  // "IN" + 発行年月(YYYYMM) + "-" + 月内連番4桁（例: IN202608-0001）。
  // src/lib/invoice.ts の generateInvoiceNo が発行日ベースで自動採番するが、
  // このカラム自体は自動生成後に手動編集も許可している（既存の請求書実物に
  // "IN202512-0021-2" のような、連番の後ろにさらに枝番が付く例があり、生成
  // ロジック側でそのすべての運用パターンを予測しきれないため）。一意制約で
  // 重複だけは常に防ぐ。
  invoiceNo     String   @unique
  entryId       Int
  // 宛名（例:「株式会社◯◯」— PDF/画面側で末尾に「様」を付与する）。作成時に
  // entry.companyName を初期値として複製するが、請求書ごとに変更できる必要が
  // ある（法人名の言い回し変更や請求書上だけの表記調整など）ため Entry への
  // 参照ではなく独立したカラムに持たせている。
  recipientName String
  issueDate     DateTime               // 発行日（JST 日付。src/lib/award-dates.ts の
                                        // jstDateStringToStartOfDayUtc で変換して保存）
  dueDate       DateTime               // 支払期限（JST 日付。初期値は「発行月の翌月末」—
                                        // src/lib/invoice-shared.ts の defaultDueDateFromIssueDate
                                        // — だが編集可能。jstDateStringToEndOfDayUtc で保存）
  notes         String   @default("") // 備考欄。デフォルト文言は
                                        // src/lib/invoice-shared.ts の DEFAULT_INVOICE_NOTES
                                        // をUI側の初期値としてセットするのみで、DBのデフォルト
                                        // 自体は空文字（過去の請求書のデフォルト文言を後から
                                        // 変えても、すでに作成済みの請求書の備考は変わらない
                                        // ようにするため — InvoiceLine が単価をコピーで持つ
                                        // のと同じ考え方）。
  // 以下3つはサーバー側で明細行から都度計算する値（税抜合計・消費税・税込合計）。
  // クライアントから送られた値は信用せず、src/lib/invoice-shared.ts の calcInvoiceTotals
  // で毎回サーバー側が計算し直す。消費税は円未満切り捨て（一般的な処理として採用
  // — 既存請求書実物からは端数処理の判断材料が取れなかったため）。
  subtotal      Int
  taxAmount     Int
  totalAmount   Int
  createdByUserId Int?               // 作成者。ユーザー削除後も履歴を残すため null 許容
  createdByName   String @default("") // 作成者名のスナップショット（EntryComment.authorName と同じ考え方）
  // 送付状況（src/app/api/invoices/[id]/send/route.ts）。複数回送信・再送しても
  // 「最後に送った送信」だけが分かればよいので3カラムを都度上書きする作りにしている
  // — 送信ごとの履歴が必要なら EmailLog（messageId 経由で Resend の配信結果まで追える）
  // 側にすでに残っているので、ここに履歴テーブルを別途持たせていない。sentAt が null の
  // 間は「未送信」— 一覧画面（src/app/invoices/page.tsx）の送信状況列や、編集画面
  // （src/components/invoice-form.tsx）の「送信済み」表示はこの null 判定だけで出し分ける。
  sentAt        DateTime?            // 最後に送信した日時（UTC instant。表示は必ず
                                        // timeZone: "Asia/Tokyo" で変換する）
  sentTo        String   @default("") // 最後に送信した宛先メールアドレス。既定は
                                        // entry.email だが送信時に変更できるため、
                                        // Entry.email をそのまま参照せずスナップショットで持つ
                                        // （InvoiceLine が InvoiceItem の値をコピーで持つのと
                                        // 同じ考え方）。
  sentBy        String   @default("") // 最後に送信した管理ユーザーのメールアドレス
                                        // （EntryComment.authorName 等と同じ「行為者の
                                        // スナップショット」パターン）。フォーム送信起点の
                                        // 送信は存在しない（canManageInvoices は
                                        // admin/representative専用）ため、必ずログイン
                                        // ユーザーが埋まる想定だが、念のため空文字許容にしている。
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entry         Entry    @relation(fields: [entryId], references: [id])
  lines         InvoiceLine[]
}

// 請求書の明細行（既存請求書の「日付 / 品名 / 数量 / 単価 / 金額」に対応）。
// name/unitPrice は InvoiceItem マスタからコピーして持つ — マスタの金額を
// 後から変えても、発行済み請求書の内容が変わってはいけないため（マスタへの
// リレーションは持たせず、値そのものを複製する。EntryImage 等の1:多と違い、
// 意図的に「参照ではなく複製」にしている）。
model InvoiceLine {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  sortOrder Int      @default(0)
  date      DateTime               // 明細行の日付（JST 日付。既定値は請求書の発行日だが行ごとに変更可）
  name      String                 // 品名（マスタからコピー、行ごとに編集可）
  quantity  Int      @default(1)   // 数量
  unit      String   @default("式") // 単位。既定は「式」
  unitPrice Int                    // 単価・税別（円）。マイナス可（マスタからコピー、編集可）
  amount    Int                    // 金額 = quantity * unitPrice（サーバー側で計算し直す）
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
