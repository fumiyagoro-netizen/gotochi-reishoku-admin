generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("viewer") // "admin" | "editor" | "viewer"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  EntryComment[]
}

model Award {
  id              Int       @id @default(autoincrement())
  year            Int       @unique
  name            String
  isActive        Boolean   @default(false)
  entryStartDate  DateTime?
  entryEndDate    DateTime?
  notifyEmails    String    @default("") // comma-separated email addresses for admin notifications
  createdAt       DateTime  @default(now())
  entries         Entry[]
}

model Entry {
  id                   Int          @id @default(autoincrement())
  awardId              Int
  answerNo             String       @unique
  answeredAt           String
  ipAddress            String       @default("")
  companyName          String
  department           String       @default("")
  contactLastName      String
  contactFirstName     String
  email                String
  phone                String       @default("")
  tradeShowExhibition  String       @default("")
  prefecture           String       @default("")
  productName          String
  productCategory      String       @default("")
  price                String       @default("")
  purchaseLocation     String       @default("")
  referenceUrl         String       @default("")
  productPhotosRaw     String       @default("")
  localAppeal          String       @default("")
  tasteAppeal          String       @default("")
  packageAppeal        String       @default("")
  cookingMethod        String       @default("")
  otherAppeal          String       @default("")
  retailPartnership    String       @default("")
  bacteriaInspection   String       @default("")
  expirationInspection String       @default("")
  manufacturingLicense String       @default("")
  entryProductLicense  String       @default("")
  hygieneManager       String       @default("")
  remarks              String       @default("")
  prizeLevel           String       @default("")
  reviewStatus         String       @default("")
  createdAt            DateTime     @default(now())
  award                Award        @relation(fields: [awardId], references: [id])
  images               EntryImage[]
  comments             EntryComment[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userEmail String   @default("")
  action    String   // "create" | "update" | "delete" | "prize" | "upload" | "login" | "bulk_prize"
  target    String   // "entry" | "user" | "session"
  targetId  String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model EntryComment {
  id         Int      @id @default(autoincrement())
  entryId    Int
  userId     Int?     // 投稿者。ユーザー削除時も履歴を残すため null 許容
  authorName String   @default("")  // 投稿者名のスナップショット（ユーザー削除後も表示できるように）
  body       String
  createdAt  DateTime @default(now())
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EntryImage {
  id        Int    @id @default(autoincrement())
  entryId   Int
  imageUrl  String
  imageType String // "main" or "sub"
  sortOrder Int    @default(0)
  entry     Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Contact {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String   @default("")
  companyName String   @default("")
  phone       String   @default("")
  source      String   @default("") // "entry" | "csv" | "manual" | "form"
  subscribed  Boolean  @default(true)
  optInAt     DateTime?
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships ContactListMembership[]
}

model ContactList {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  memberships ContactListMembership[]
}

model ContactListMembership {
  id        Int         @id @default(autoincrement())
  contactId Int
  listId    Int
  addedAt   DateTime    @default(now())
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
}

model Suppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  reason    String   // "unsubscribe" | "bounce" | "manual"
  createdAt DateTime @default(now())
}

model EmailLog {
  id           Int       @id @default(autoincrement())
  toEmail      String
  subject      String
  status       String    // "sent" | "failed" | "skipped" | "test"
  sentBy       String    @default("")
  createdAt    DateTime  @default(now())
  // Resend's message id for this send. Used to match incoming
  // /api/webhooks/resend delivery events back to the row that created them
  // (see src/app/api/webhooks/resend/route.ts). Empty for rows created
  // before this column existed, and for rows where the send never reached
  // Resend (e.g. missing RESEND_API_KEY, or skipped due to suppression).
  messageId    String    @default("")
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  // Bounce detail from Resend's payload (bounce.type / bounce.subType /
  // bounce.message), e.g. "Permanent / Suppressed: The recipient's email
  // address is on the suppression list...". Empty unless bouncedAt is set.
  bounceReason String    @default("")

  // Webhook lookups are always `WHERE messageId = ?`, so this index is
  // required for that query to be a lookup rather than a full table scan.
  @@index([messageId])
  // The delivery-history admin screen (src/app/email-logs/page.tsx) always
  // orders by createdAt desc with skip/take pagination; without this index
  // that query degrades to a full-table sort as EmailLog grows past the
  // current ~300 rows.
  @@index([createdAt])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Form {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  description     String   @default("")
  status          String   @default("draft") // "draft" | "published" | "closed"
  fields          Json     // フィールド定義の配列 (see src/lib/form.ts for shape)
  targetListId    Int?     // 回答者を登録する見込みリスト（任意）
  requireOptIn    Boolean  @default(false)
  thankYouMessage String   @default("")
  autoReplyEnabled Boolean @default(false)
  autoReplySubject String  @default("")
  autoReplyBody    String  @default("")
  notifyEmails    String   @default("") // comma-separated email addresses for admin notifications
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  submissions     FormSubmission[]
}

model FormSubmission {
  id        Int      @id @default(autoincrement())
  formId    Int
  answers   Json     // { fieldId: value } 。ファイルはBlobのURL文字列（複数可なら配列）
  contactId Int?
  ipAddress String   @default("")
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
}

// Standalone "追客リスト" (prospecting list) of candidate manufacturers to
// reach out to for future award entries. Deliberately has NO relation to
// Contact/ContactList/Entry — it's a separate sales-outreach concern, gated
// by its own canManageProspects flag (see src/lib/role-shared.ts).
//
// makerName/prefecture/productName/tempZone/confidence/supplement/url come
// from a one-time (and repeatable) Excel import — see
// importProspectsFromExcel in src/lib/prospect.ts. A re-import skips any row
// whose makerName+productName pair already exists, so the four operational
// columns below (hand-maintained through the app, not the spreadsheet) are
// never clobbered by a re-upload of the source list.
//
// No extra @@index: the source list is ~277 manufacturers and grows only via
// occasional manual Excel imports, so every filter (contactStatus/
// prefecture/confidence/assignee) and the makerName/productName keyword
// search stay full-table-scan-fast at this size — same reasoning already
// applied to Entry/Contact, which don't index their filterable columns
// either. Revisit if this list ever grows into the thousands.
model Prospect {
  id            Int      @id @default(autoincrement())
  makerName     String                        // メーカー名
  prefecture    String   @default("")         // 県名
  productName   String   @default("")         // 商品名
  tempZone      String   @default("")         // サイトで確認できる温度帯
  confidence    String   @default("")         // 確度（高/中/低）
  supplement    String   @default("")         // 補足
  url           String   @default("")         // URL
  // 運用項目（アプリ上で手入力・編集する）。Excelインポートでは触らない。
  contactStatus String   @default("未着手")   // コンタクト状況: 未着手/連絡済/資料送付済/エントリー意向
  assignee      String   @default("")         // 担当者
  email         String   @default("")         // 連絡先（メールアドレス）
  memo          String   @default("")         // 備考・メモ欄
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
